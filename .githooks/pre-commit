#!/usr/bin/env bash
#
# .githooks/pre-commit — brick wall.
#
# Runs the full verify gate before any commit is allowed. If build, the live
# connect-to-robot_brain test, or test_suite fails, the commit is aborted.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Bypass (ONLY for trivial doc-only edits, never for src/ changes):
#   git commit --no-verify   (but then you own the consequences)
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/scripts/gate.sh"
