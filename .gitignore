# Protect workspace configuration
.zed/
.delta/
# Block heavy, unstable Rust build folders and ghost files
target/*

# Cargo.lock — robot_brain is a binary crate; test_suite is a separate
# independent binary crate. Neither lock file should be committed.
Cargo.lock

# Agent documentation and scripts - NEVER commit
AGENTS.md
.agents/githooks/*
.agents/githooks/pre-commit
.agents/githooks/pre-push
.agents/notes/*
.agents/notes/ToDo.md
.agents/TEST_SUITE_NOTES.md
.agents/PLAN.md
.agents/LARGE_FILE_REFACTOR.md
.agents/context_save.md
.agents/CHANGELOG.md
.agents/skills/robot-brain/skill.md
.agents/scripts/test_output.txt
